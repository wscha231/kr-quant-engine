# Streamlit Cloud secrets template (Phase D).
#
# 1. Copy to Streamlit Cloud project Settings -> Secrets (NOT committed).
# 2. Local dev: rename to .streamlit/secrets.toml (already in .gitignore).
#
# All secrets here are injected via st.secrets["KEY"] in streamlit_app.py.

# ---------------------------------------------------------------------------
# DART (Korea Financial Supervisory Service OpenAPI)
# Free key: https://opendart.fss.or.kr/
# ---------------------------------------------------------------------------
DART_API_KEY = "REPLACE_WITH_YOUR_DART_KEY"

# ---------------------------------------------------------------------------
# BOK ECOS (Bank of Korea statistics)
# Free key: https://ecos.bok.or.kr/api/
# ---------------------------------------------------------------------------
BOK_ECOS_API_KEY = "REPLACE_WITH_YOUR_BOK_KEY"

# ---------------------------------------------------------------------------
# rclone config for GDrive sync (read-only token preferred)
# Run `rclone config show` locally and paste the [gdrive] block content here.
# Used by GitHub Actions only; Streamlit Cloud usually reads committed CSVs.
# ---------------------------------------------------------------------------
RCLONE_CONFIG_GDRIVE = """
[gdrive]
type = drive
scope = drive.readonly
token = {"access_token":"...","token_type":"Bearer","refresh_token":"...","expiry":"..."}
team_drive =
"""

# ---------------------------------------------------------------------------
# Slack incoming webhook for run notifications (optional)
# https://api.slack.com/messaging/webhooks
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL = ""

# ---------------------------------------------------------------------------
# KIS (Korea Investment & Securities) API for paper / live trading
# Phase E only. Local PC only -- never store on GitHub Actions.
# ---------------------------------------------------------------------------
# KIS_APP_KEY = ""
# KIS_APP_SECRET = ""
# KIS_ACCOUNT_NUMBER = ""
