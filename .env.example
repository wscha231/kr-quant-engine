# Copy this file to .env and fill in your API keys.
# .env is gitignored — NEVER commit real keys.

# DART OpenAPI — https://opendart.fss.or.kr (free, registration required, 2-day approval)
DART_API_KEY=your_dart_key_here

# Bank of Korea ECOS — https://ecos.bok.or.kr/api (free)
BOK_ECOS_API_KEY=your_bok_key_here

# KOSIS (Statistics Korea) — https://kosis.kr/openapi (free, optional for P3+)
KOSIS_API_KEY=your_kosis_key_here

# Optional: paid data later
# FNGUIDE_API_KEY=
# QUANTIWISE_API_KEY=

# Data storage location (override default PROJECT_ROOT for cache/outputs)
# Recommended: GDrive path for backup + Colab compatibility
# KR_DATA_DIR=G:/내 드라이브/kr_quant_engine
